{
  "name": "trymesh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @trymesh/app dev",
    "build": "pnpm --filter @trymesh/app build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp:build": "pnpm --filter @trymesh/mcp build",
    "mcp": "node packages/mcp/dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
